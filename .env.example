# Postgres (docker-compose.yml)
POSTGRES_USER=lendara
POSTGRES_PASSWORD=lendara
POSTGRES_DB=lendara
POSTGRES_PORT=5432

# API (apps/api)
PORT=8080
DATABASE_URL=postgres://lendara:lendara@localhost:5432/lendara?sslmode=disable
LOG_LEVEL=info

# Integration tests (optional; tests are skipped when empty)
TEST_DATABASE_URL=postgres://lendara:lendara@localhost:5432/lendara?sslmode=disable
