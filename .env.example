# Postgres (docker-compose.yml)
POSTGRES_USER=lendara
POSTGRES_PASSWORD=lendara
POSTGRES_DB=lendara
POSTGRES_PORT=5432

# API (apps/api)
PORT=8080
DATABASE_URL=postgres://lendara:lendara@localhost:5432/lendara?sslmode=disable
LOG_LEVEL=info
API_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:3000
# Signs SEP-10 session tokens. At least 32 characters: `openssl rand -hex 32`
SEP10_JWT_SECRET=

# Web (apps/web). Public: inlined in the browser bundle at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Demo store (apps/demo). Server-only: a project API key from POST /v1/projects.
LENDARA_API_KEY=
LENDARA_API_BASE_URL=http://localhost:8080

# Integration tests (optional; tests are skipped when empty)
TEST_DATABASE_URL=postgres://lendara:lendara@localhost:5432/lendara?sslmode=disable

# Stellar testnet. Run `make setup-testnet` and paste its output here.
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Comma-separated; the first is set on the issuer account (max 32 characters).
STELLAR_HOME_DOMAIN=localhost:8080
STELLAR_ISSUER_PUBLIC_KEY=
STELLAR_ISSUER_SECRET=
STELLAR_DISTRIBUTION_SECRET=
STELLAR_SIGNING_SECRET=
